{
  "name": "odin-eye",
  "version": "0.3.0",
  "description": "Find accessibility, SEO and layout issues directly on your page while you develop",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SRamoras/odin-eye.git"
  },
  "keywords": [
    "react",
    "accessibility",
    "a11y",
    "seo",
    "nextjs",
    "vite",
    "ui",
    "devtools"
  ],
  "homepage": "https://odin-eye.vercel.app",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axe-core": "^4.13.0"
  }
}
